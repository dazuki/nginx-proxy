# Drop-in for the standalone nginx-proxy stack.
# Copy to its nginx/conf.d/locations/myapp.conf and run ./reload.sh.
#
# Reached over the shared `mcp-net` podman network by container name, so this
# MCP publishes no host port. The trailing slash on proxy_pass strips the
# prefix: /myapp/mcp arrives upstream as /mcp, which is MCP_PATH.

location = /myapp {
    return 308 /myapp/;
}

location /myapp/ {
    include /etc/nginx/snippets/proxy.conf;
    # include /etc/nginx/snippets/proxy-sse.conf; - MCP streamable HTTP
    proxy_pass http://myapp-container:8080/;
}