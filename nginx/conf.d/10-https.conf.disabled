server {
    listen 443 ssl default_server;
    server_name _;

    absolute_redirect off;

    # { cat /etc/ssl/certs/star_<domain>_se.crt; echo; cat /etc/ssl/certs/DigiCertCA.crt; } > nginx/ssl/fullchain.pem
    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # ssl_certificate         /etc/nginx/ssl/star_<domain>_se.crt;
    # ssl_trusted_certificate /etc/nginx/ssl/DigiCertCA.crt;

    ssl_protocols       TLSv1.2 TLSv1.3;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/locations/*.conf;

    location / {
        return 444;
    }
}