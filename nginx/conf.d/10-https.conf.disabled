# HTTPS listener. Disabled until a cert exists: nginx refuses to start if a
# cert file is missing. To enable:
#
#   cp <cert chain> nginx/ssl/fullchain.pem
#   cp <key>        nginx/ssl/privkey.pem
#   cp nginx/conf.d/10-https.conf.disabled nginx/conf.d/10-https.conf
#   ./reload.sh
#
# Serves the same locations/ drop-ins as port 80, so services need no changes.
# Port 80 keeps working (no redirect); a drop-in can force HTTPS on its own,
# see locations/example.conf.disabled.

server {
    listen 443 ssl default_server;
    server_name _;

    absolute_redirect off;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/locations/*.conf;

    location / {
        return 444;
    }
}
